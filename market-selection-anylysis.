<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Market Selection Analysis</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
body {
    margin: 0;
    background: #06152b;
    color: white;
    font-family: Arial, sans-serif;
}

header {
    padding: 35px;
    background: #082344;
}

h1 {
    font-size: 40px;
}

h1 span {
    color: #00d9e8;
}

.container {
    padding: 25px;
}

.card {
    background: #08213f;
    padding: 25px;
    border-radius: 15px;
    margin-bottom: 20px;
    border: 1px solid #087ba5;
}

h2 {
    color: #00d9e8;
}

.chart-container {
    height: 400px;
}

.insights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.insight {
    background: #0b294a;
    padding: 20px;
    border-radius: 10px;
}

footer {
    text-align: center;
    padding: 20px;
    color: #8eacc9;
}

@media(max-width:700px) {
    .insights {
        grid-template-columns: 1fr;
    }
    h1 {
        font-size: 28px;
    }
}
</style>
</head>

<body>

<header>
    <h1>Market Selection <span>Analysis</span></h1>
    <p>
        Explore market-level revenue trends.
        Identify treated and donor markets.
    </p>
</header>

<div class="container">

<div class="card">
    <h2>Project Objective</h2>
    <p>
        Explore market-level revenue trends.
        Identify a treated market and potential donor markets.
        Separate pre-treatment and post-treatment periods.
    </p>
</div>

<div class="card">
    <h2>Market Revenue Trends</h2>
    <p>Pre-treatment vs Post-treatment analysis</p>

    <div class="chart-container">
        <canvas id="revenueChart"></canvas>
    </div>
</div>

<div class="card">
    <h2>Key Insights</h2>

    <div class="insights">

        <div class="insight">
            <h3>📈 Treated Market</h3>
            <p>Revenue shows an uplift after treatment.</p>
        </div>

        <div class="insight">
            <h3>📊 Donor Markets</h3>
            <p>Donor markets remain comparatively stable.</p>
        </div>

        <div class="insight">
            <h3>🎯 Analysis</h3>
            <p>Compare market performance before and after treatment.</p>
        </div>

    </div>
</div>

</div>

<footer>
    Market Selection Analysis | Data Analytics Project
</footer>

<script>

const ctx = document.getElementById('revenueChart');

new Chart(ctx, {

    type: 'line',

    data: {

        labels: [
            'Week 1','Week 2','Week 3','Week 4',
            'Week 5','Week 6','Week 7','Week 8',
            'Week 9','Week 10','Week 11','Week 12'
        ],

        datasets: [

            {
                label: 'Treated Market',
                data: [42,44,46,49,50,50,57,65,72,77,80,84],
                borderColor: '#00d9e8',
                backgroundColor: '#00d9e8',
                borderWidth: 3,
                tension: 0.3
            },

            {
                label: 'Donor A',
                data: [30,32,34,37,37,36,37,41,44,46,46,47],
                borderColor: '#32d6a7',
                borderWidth: 3,
                tension: 0.3
            },

            {
                label: 'Donor B',
                data: [24,26,27,29,30,29,30,33,35,37,38,39],
                borderColor: '#a47af4',
                borderWidth: 3,
                tension: 0.3
            },

            {
                label: 'Donor C',
                data: [15,16,17,18,19,19,20,22,24,25,26,27],
                borderColor: '#7ca9e8',
                borderWidth: 3,
                tension: 0.3
            }

        ]

    },

    options: {

        responsive: true,
        maintainAspectRatio: false,

        plugins: {
            legend: {
                labels: {
                    color: 'white'
                }
            }
        },

        scales: {

            x: {
                ticks: {
                    color: 'white'
                },
                title: {
                    display: true,
                    text: 'Time',
                    color: 'white'
                }
            },

            y: {
                ticks: {
                    color: 'white'
                },
                title: {
                    display: true,
                    text: 'Revenue',
                    color: 'white'
                }
            }

        }

    }

});

</script>

</body>
</html>
